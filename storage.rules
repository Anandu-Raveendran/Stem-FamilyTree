rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /families/{familyId}/members/{memberId}/{fileName} {
      allow read: if true;
      allow create: if request.resource.size < 20 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow update: if request.resource.size < 20 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if true;
    }
  }
}
